{
  "name": "@pigeonbox/mailbox",
  "version": "0.5.1",
  "description": "Local mailbox persistence in IndexedDB (Dexie): threads, messages, search documents and derived state.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pigeonbox/shared": "*",
    "dexie": "^4.0.11"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
