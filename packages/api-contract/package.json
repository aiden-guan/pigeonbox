{
  "name": "@pigeonbox/api-contract",
  "version": "0.5.0",
  "private": true,
  "description": "Typed PigeonBox Cloud protocol: request, response and error schemas shared by the extension and the hosted API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
