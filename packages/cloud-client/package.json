{
  "name": "@pigeonbox/cloud-client",
  "version": "0.8.4",
  "private": true,
  "description": "HTTP client for the PigeonBox Cloud API, plus a Cloud-backed AIProvider.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
