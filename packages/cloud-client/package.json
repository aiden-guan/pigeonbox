    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pigeonbox/ai": "*",
    "@pigeonbox/api-contract": "*",
    "@pigeonbox/shared": "*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  }
}
