# PigeonBox server settings.
# Copy to server.env (gitignored; `npm run server:deploy` does it for you), fill
# in the required values, then run `npm run server:deploy`.
# Where each value comes from: docs/self-hosting.md.
#
# Encryption keys and salts are generated for you into .local/server-secrets.json.
# Back that file up: without it, the mail data your server stores can't be read.

# --- Required -----------------------------------------------------------------

# Who may sign in: email addresses and @domains, comma-separated.
# `*` lets anyone with a Google account use your server (and your AI key).
ALLOWED_EMAILS=you@example.com

# Supabase project (supabase.com, free tier is fine).
# Project Settings → API: project URL, anon (publishable) key, service_role (secret) key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Transaction pooler connection string (port 6543), with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Any OpenAI-compatible chat + embeddings endpoint.
CLOUD_AI_BASE_URL=https://api.openai.com/v1
CLOUD_AI_API_KEY=
CLOUD_AI_PRIMARY_MODEL=gpt-4.1-mini
CLOUD_AI_EMBED_MODEL=text-embedding-3-small

# --- Sign-in with Google -------------------------------------------------------

# A Google Cloud OAuth client (Web application). Used by Supabase for sign-in and,
# with the Pub/Sub settings below, for the always-on Gmail connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: a Supabase personal access token (supabase.com/dashboard/account/tokens).
# With it, deploy configures Supabase Auth's redirect URLs and Google provider for you;
# without it, deploy prints the two settings to make by hand.
SUPABASE_ACCESS_TOKEN=

# --- Optional features ---------------------------------------------------------

# Always-on Gmail: background sync, prepared drafts, follow-ups, briefings, Ask over
# all your mail. Needs a Pub/Sub topic Gmail can publish to (docs/self-hosting.md#always-on-gmail).
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=

# Tracked PDFs: name of a private Supabase Storage bucket (created if missing).
DOCUMENTS_BUCKET=

# Set to true on the Workers Paid plan: raises CPU and subrequest limits, which the
# always-on Gmail layer needs once a mailbox is busy.
WORKERS_PAID=false

# Send pixel and click events through a Cloudflare Queue (more resilient under load).
TRACKER_QUEUE=false

# Optional per-account monthly AI budget in micro-dollars (2000000 = $2), using the
# CLOUD_AI_*_COST_PER_1K_MICROS prices you set. Off when unset.
# CLOUD_AI_MONTHLY_BUDGET_MICROS=
# CLOUD_AI_INPUT_COST_PER_1K_MICROS=
# CLOUD_AI_OUTPUT_COST_PER_1K_MICROS=

# --- Advanced ------------------------------------------------------------------

# Worker names become <prefix>-api and <prefix>-tracker on your workers.dev subdomain.
WORKER_NAME_PREFIX=pigeonbox
# Custom domains you've routed to the Workers, instead of workers.dev.
# API_URL=https://pigeonbox.example.com
# TRACKER_URL=https://t.example.com
# Your extension's ID when you don't use the generated key (chrome://extensions).
# EXTENSION_ID=
# More extension IDs allowed to sign in, comma-separated (for example a second browser).
# EXTRA_EXTENSION_IDS=
# Cloudflare Hyperdrive config ID for faster database connections. Point Hyperdrive at the
# Supabase *session* pooler (port 5432) with caching disabled; DATABASE_URL is then only used
# for migrations.
# HYPERDRIVE_ID=
# Projects that still verify sessions with Supabase's legacy JWT secret.
# SUPABASE_JWT_SECRET=
