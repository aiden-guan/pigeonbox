# Public build-time settings for the extension. Everything here is compiled into
# the shipped JavaScript, so it must never contain a secret.
# Copy to apps/extension/.env.local to use (gitignored).

# PigeonBox Cloud API origin. Blank (the default for source builds) means Cloud
# is unavailable and PigeonBox runs Local only. For local Cloud development:
#   VITE_PIGEONBOX_CLOUD_API_URL=http://127.0.0.1:8788
VITE_PIGEONBOX_CLOUD_API_URL=

# Hosted tracker origin for Cloud mode. Local dev uses http://127.0.0.1:8789.
VITE_PIGEONBOX_CLOUD_TRACKER_URL=

# Earlier origins of the same hosted tracker, comma-separated (for example its
# workers.dev address after moving to a custom domain). Sent mail keeps those
# pixel URLs; listing them keeps your own views of that mail from counting.
VITE_PIGEONBOX_CLOUD_TRACKER_PREVIOUS_URLS=

# "false" hides experimental features. Release builds force false.
VITE_PIGEONBOX_EXPERIMENTAL=

# Store item's public key (Developer Dashboard → Package → View public key).
# Gives the unpacked build in dist/ the same extension ID as the Chrome Web
# Store item. Not a secret; never added to release builds.
PIGEONBOX_EXTENSION_KEY=
